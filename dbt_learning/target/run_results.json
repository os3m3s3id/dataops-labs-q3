\n\nfinal as (\n\n    select\n        order_item_id,\n        order_id,\n        product_id,\n        customer_id,\n        store_id,\n        order_date,\n        order_status,\n        quantity,\n        unit_price,\n        discount_pct,\n        cost_price,\n        quantity * unit_price as gross_amount,\n        quantity * unit_price * discount_pct / 100 as discount_amount,\n        quantity * unit_price * (1 - discount_pct / 100) as net_amount,\n        quantity * cost_price as total_cost,\n        (quantity * unit_price * (1 - discount_pct / 100)) - (quantity * cost_price) as margin\n    from joined\n\n)\n\nselect * from final", "relation_name": "\"ecommerce\".\"DEV\".\"fct_order_items\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-19T10:22:17.299000Z", "completed_at": "2026-08-19T10:22:17.321858Z"}, {"name": "execute", "started_at": "2026-08-19T10:22:17.325610Z", "completed_at": "2026-08-19T10:22:17.477208Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.2007737159729004, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.dbt_learning.unique_dim_stores_store_id.0479724a85", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    store_id as unique_field,\n    count(*) as n_records\n\nfrom \"ecommerce\".\"DEV\".\"dim_stores\"\nwhere store_id is not null\ngroup by store_id\nhaving count(*) > 1\n\n\n", "relation_name": "\"ecommerce\".\"dbt_test__audit\".\"unique_dim_stores_store_id\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-19T10:22:17.432380Z", "completed_at": "2026-08-19T10:22:17.466715Z"}, {"name": "execute", "started_at": "2026-08-19T10:22:17.472359Z", "completed_at": "2026-08-19T10:22:17.645831Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.23656654357910156, "adapter_response": {"_m