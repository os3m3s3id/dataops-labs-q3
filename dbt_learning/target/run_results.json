n\nselect *\nfrom \"ecommerce\".\"STAGE\".\"stg_orders\"\nwhere order_id is null\n\n\n", "relation_name": "\"ecommerce\".\"dbt_test__audit\".\"not_null_stg_orders_order_id\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-02T09:56:53.720928Z", "completed_at": "2026-09-02T09:56:53.737373Z"}, {"name": "execute", "started_at": "2026-09-02T09:56:53.745575Z", "completed_at": "2026-09-02T09:56:53.745586Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.04026293754577637, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.dbt_learning.unique_stg_orders_order_id.e3b841c71a", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    order_id as unique_field,\n    count(*) as n_records\n\nfrom \"ecommerce\".\"STAGE\".\"stg_orders\"\nwhere order_id is not null\ngroup by order_id\nhaving count(*) > 1\n\n\n", "relation_name": "\"ecommerce\".\"dbt_test__audit\".\"unique_stg_orders_order_id\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-02T09:56:53.728164Z", "completed_at": "2026-09-02T09:56:53.742978Z"}, {"name": "execute", "started_at": "2026-09-02T09:56:53.746843Z", "completed_at": "2026-09-02T09:56:53.746854Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.04048776626586914, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dbt_learning.dim_products", "compiled": true, "compiled_code": "with stg_products as (\n\n    select * from \"ecommerce\".\"STAGE\".\"stg_products\"\n\n),\n\nfinal as (\n\n    select\n        product_id,\n        product_name,\n        category,\n        subcategory,\n        currency,\n        launch_date,\n        is_active,\n        cost_price,\n        list_price,\n        list_price - cost_price as unit_margin\n    from stg_products\n\n)\n\nselect * from final", "relation_name": "\"ecommerce\".\"DEV\".\"dim_products\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-02T09:56:53.737756Z", "completed_at": "2026-09-02T09:56:53.753988Z"}, {"name": "execute", "started_at": "2026-09-02T09:56:53.757374Z", "completed_at": "2026-09-02T09:56:53.757386Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.022629976272583008, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.dbt_learning.fct_order_items", "compiled": true, "compiled_code": "---This changes the behavior of the table instead of dropping and build again it just insert new rows and merge (If not exist) or update (if exist)\n\n\n\nwith order_items as (\n\n    select * from \"ecommerce\".\"STAGE\".\"stg_order_items\"\n    -- By doing this we will tell dbt to not take take the entier tables and join them in every run, we till it to skip the rows which are already built.ABORT\n    \n        where order_item_id > (select coalesce(max(order_item_id), 0) from \"ecommerce\".\"DEV\".\"fct_order_items\")\n    \n\n),\n\norders as (\n\n    select * from \"ecommerce\".\"STAGE\".\"stg_orders\"\n\n),\n\nproducts as (\n\n    select * from \"ecommerce\".\"STAGE\".\"stg_products\"\n\n),\n\njoined as (\n\n    select\n        order_items.order_item_id,\n        order_items.order_id,\n        order_items.product_id,\n        orders.customer_id,\n        orders.store_id,\n        orders.order_date,\n        orders.order_status,\n        order_items.quantity,\n        order_items.unit_price,\n        order_items.discount_pct,\n        products.cost_price\n    from order_items\n    left join orders on order_items.order_id = orders.order_id\n    left join products on order_items.product_id = products.product_id\n\n),\n\nfinal as (\n\n    select\n        order_item_id,\n        order_id,\n        product_id,\n        customer_id,\n        store_id,\n        order_date,\n        order_status,\n        quantity,\n        unit_price,\n     