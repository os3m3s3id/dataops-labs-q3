rs on order_items.order_id = orders.order_id\n    left join products on order_items.product_id = products.product_id\n\n),\n\nfinal as (\n\n    select\n        order_item_id,\n        order_id,\n        product_id,\n        customer_id,\n        store_id,\n        order_date,\n        order_status,\n        quantity,\n        unit_price,\n        discount_pct,\n        cost_price,\n        quantity * unit_price as gross_amount,\n        quantity * unit_price * discount_pct / 100 as discount_amount,\n        \n    (quantity * unit_price * (1 - discount_pct / 100.0))\n as net_amount,\n        quantity * cost_price as total_cost,\n        \n    (quantity * unit_price * (1 - discount_pct / 100.0))\n - (quantity * cost_price) as margin\n    from joined\n\n)\n\nselect * from final", "relation_name": "\"ecommerce\".\"DEV\".\"fct_order_items\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-21T12:29:19.846059Z", "completed_at": "2026-09-21T12:29:19.868169Z"}, {"name": "execute", "started_at": "2026-09-21T12:29:19.869971Z", "completed_at": "2026-09-21T12:29:20.080818Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.2618546485900879, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.dbt_learning.unique_dim_stores_store_id.0479724a85", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    store_id as unique_field,\n    count(*) as n_records\n\nfrom \"ecommerce\".\"DEV\".\"dim_stores\"\nwhere store_id is not null\ngroup by store_id\nhaving count(*) > 1\n\n\n", "relation_name": "\"ecommerce\".\"dbt_test__audit\".\"unique_dim_stores_store_id\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-09-21T12:29:20.037608Z", "completed_at": "2026-09-21T12:29:20.078217Z"}, {"name": "execute", "started_at": "2026-09-21T12:29:20.082911Z", "c